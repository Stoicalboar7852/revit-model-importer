<Window x:Class="RevitModelImporter.Revit.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Model Importer settings"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12" ShowInTaskbar="False" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RevitModelImporter.Revit;component/UI/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel Margin="14">
    <GroupBox Header="Simplification recommendation">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CheckBox Grid.ColumnSpan="2" Margin="0,2,0,6" IsChecked="{Binding ShowRecommendation}"
                  Content="Show a recommendation to simplify large models in the Import dialog" />
        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Recommend above" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <TextBox Width="110" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ShowRecommendation}" />
          <TextBlock Margin="6,0" VerticalAlignment="Center" Text="faces" />
        </StackPanel>
        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Strongly recommend above" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
          <TextBox Width="110" Text="{Binding StrongThreshold, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ShowRecommendation}" />
          <TextBlock Margin="6,0" VerticalAlignment="Center" Text="faces" />
        </StackPanel>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Note}" Margin="0,4,0,0"
                   Text="The recommendation is only a notice. Simplify is never switched on for you, and importing without simplifying never asks for confirmation." />
      </Grid>
    </GroupBox>

    <GroupBox Header="Textures">
      <StackPanel>
        <TextBlock Style="{StaticResource Note}" Text="Textures are copied next to the project (&lt;project folder&gt;\&lt;project name&gt;_textures). Until the project is saved, this folder is used instead:" />
        <DockPanel Margin="0,2">
          <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" />
          <TextBox Text="{Binding FallbackTextureFolder, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <CheckBox Margin="0,4,0,0" IsChecked="{Binding AlwaysUseFallbackTextureFolder}" Content="Always use this folder, even for saved projects" />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="Advanced">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Label}" Text="Faces per geometry build" />
        <TextBox Width="110" Text="{Binding MaxTrianglesPerBuild, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Large material groups are split into chunks of this size for Revit's TessellatedShapeBuilder." />
      </StackPanel>
    </GroupBox>

    <TextBlock Foreground="#A4262C" Text="{Binding ValidationMessage}" Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,6" />
    <TextBlock Style="{StaticResource Note}" Text="{Binding SettingsFilePath, StringFormat='Saved in {0}'}" />

    <DockPanel Margin="0,10,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Margin="0" Content="Restore defaults" Command="{Binding ResetCommand}" />
      <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button DockPanel.Dock="Right" Content="Save" IsDefault="True" Command="{Binding SaveCommand}" />
    </DockPanel>
  </StackPanel>
</Window>
