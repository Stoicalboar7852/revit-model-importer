<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The add-in assembly loaded by Revit. Thin on purpose: references only RevitModelImporter.Core (no NuGet
    runtime dependencies) so it cannot conflict with Revit or other add-ins. Everything native lives in the worker.

    Revit year selection (2025 and 2026 share net8.0-windows):
      dotnet build -f net8.0-windows  -p:RevitVersion=2025
      dotnet build -f net8.0-windows  -p:RevitVersion=2026   (default for net8.0-windows)
      dotnet build -f net10.0-windows -p:RevitVersion=2027   (default for net10.0-windows)
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>RevitModelImporter.Revit</RootNamespace>
    <AssemblyName>RevitModelImporter.Revit</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Revit loads the add-in from its own folder; it must not copy RevitAPI*.dll. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF's generated code and Revit's API surface trigger a few analyzer rules that are not useful here. -->
    <NoWarn>$(NoWarn);CA1416;CA1001;CA1063;CA1816;CA2201;CA1305;CA1515;CA1711;CA1849;CA2008</NoWarn>
  </PropertyGroup>

  <!-- Map target framework → Revit year. RevitYear is internal: a global -p:RevitVersion cannot be overridden per
       target framework, so it only selects between the two net8.0-windows years. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <RevitYear>2027</RevitYear>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <RevitYear Condition="'$(RevitVersion)' == '2025'">2025</RevitYear>
    <RevitYear Condition="'$(RevitVersion)' != '2025'">2026</RevitYear>
  </PropertyGroup>
  <PropertyGroup>
    <RevitApiPackageVersion Condition="'$(RevitYear)' == '2025'">2025.0.2</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitYear)' == '2026'">2026.0.4</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitYear)' == '2027'">2027.0.20</RevitApiPackageVersion>
    <DefineConstants>$(DefineConstants);REVIT$(RevitYear)</DefineConstants>
    <DefineConstants Condition="'$(RevitYear)' != '2025'">$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
    <!-- Keep each Revit year's output separate (obj\R2025 is set in Directory.Build.props). -->
    <OutputPath>bin\$(Configuration)\R$(RevitYear)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="CheckRevitVersion" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' != '' And '$(RevitVersion)' != '' And '$(RevitVersion)' != '$(RevitYear)'">
    <Error Text="RevitVersion=$(RevitVersion) cannot be built as $(TargetFramework): Revit 2025 and 2026 use net8.0-windows, Revit 2027 uses net10.0-windows. Add -f to pick the matching target framework." />
  </Target>

  <ItemGroup>
    <!-- Compile-only reference assemblies; never copied, never committed. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitModelImporter.Core\RevitModelImporter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Net.Http" />
  </ItemGroup>

  <Target Name="ShowRevitVersion" BeforeTargets="CoreCompile">
    <Message Importance="high" Text="$(MSBuildProjectName) $(TargetFramework) → Revit $(RevitYear) (API package $(RevitApiPackageVersion))" />
  </Target>
</Project>
