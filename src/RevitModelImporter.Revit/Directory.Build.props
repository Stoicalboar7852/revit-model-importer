<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Revit 2025 and 2026 share net8.0-windows but compile against different API packages, so a 2025 build
       needs its own restore/intermediate folder (this must be set before the SDK is imported). -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <BaseIntermediateOutputPath>obj\R2025\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
