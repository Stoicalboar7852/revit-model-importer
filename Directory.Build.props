<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Authors>Revit Model Importer contributors</Authors>
    <Company>Revit Model Importer</Company>
    <Product>Revit Model Importer</Product>
    <Copyright>Copyright (c) 2026 Revit Model Importer contributors</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Lets the WPF add-in build on Linux/macOS. Harmless for the other projects. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Analyzer rules that are noise for this code base (documented in docs/DESIGN.md). -->
    <NoWarn>$(NoWarn);CA1062;CA1303;CA1305;CA1307;CA1310;CA1716;CA1720;CA1724;CA1812;CA1819;CA1822;CA1848;CA2007;CA2225;CA5394;CA1002;CA1031;CA1051;CA1024;CA1508;CA1309;CA1311;CA1304;CA1861;CA1814;CA1815;CA1067;CA1036;CA1000;CA1003;CA1028;CA1056;CA1054;CA1055;CA2000;CA1859;CA1850;CA1865;CA1866;CA1867</NoWarn>
  </PropertyGroup>
</Project>
